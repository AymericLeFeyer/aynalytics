{
  "name": "aynalytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:collector": "npm run build -w @aynalytics/sdk && npm run dev -w @aynalytics/collector",
    "dev:api": "npm run dev -w @aynalytics/dashboard-api",
    "dev:web": "npm run dev -w @aynalytics/dashboard-web",
    "build": "npm run build -w @aynalytics/sdk && npm run build -w @aynalytics/collector && npm run build -w @aynalytics/dashboard-api && npm run build -w @aynalytics/dashboard-web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.12"
  }
}
