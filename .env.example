# --- Commun ---
# Dossier hote monte dans les deux conteneurs (base SQLite partagee). Doit appartenir a l'UID 1000.
DATA_PATH=./data
TAG=latest
LOG_LEVEL=info

# --- Collector (public, derriere le reverse proxy HTTPS) ---
COLLECTOR_BIND=127.0.0.1
COLLECTOR_PORT=8080
# Proxies de confiance pour lire X-Forwarded-For (IP reelle -> rate limit + hash visiteur).
# Liste d'IP/CIDR ou mots-cles proxy-addr (loopback, uniquelocal). Ne pas mettre "true" si le port est expose.
TRUST_PROXY=loopback,172.16.0.0/12
RATE_LIMIT_PER_MINUTE=240
# 0 = conservation illimitee des evenements
RETENTION_DAYS=0

# --- Dashboard (interne, VPN uniquement) ---
# IP de l'interface VPN du serveur (ex : WireGuard). Le dashboard n'ecoute que la.
DASHBOARD_BIND=10.8.0.1
DASHBOARD_PORT=8081
BASIC_AUTH_USER=admin
# 12 caracteres minimum (ex : openssl rand -base64 24)
BASIC_AUTH_PASSWORD=
# URL publique du collector, utilisee pour generer les snippets d'integration
COLLECTOR_PUBLIC_URL=https://analytics.mondomaine.fr
