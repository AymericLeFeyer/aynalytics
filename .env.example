# --- Commun ---
# Dossier hote monte dans les deux conteneurs (base SQLite partagee). Doit appartenir a l'UID 1000.
DATA_PATH=./data
TAG=latest
LOG_LEVEL=info
# Reseau Docker de Pangolin (docker network ls). Traefik y joint aynalytics-collector et aynalytics-dashboard.
PROXY_NETWORK=pangolin

# --- Collector (public via une ressource Pangolin sans authentification) ---
# Proxies de confiance pour lire X-Forwarded-For (IP reelle -> rate limit + hash visiteur).
# Doit couvrir le sous-reseau de PROXY_NETWORK (docker network inspect pangolin). Jamais "true".
TRUST_PROXY=loopback,172.16.0.0/12,10.0.0.0/8
RATE_LIMIT_PER_MINUTE=240
# 0 = conservation illimitee des evenements
RETENTION_DAYS=0

# --- Dashboard (ressource Pangolin protegee par SSO) ---
BASIC_AUTH_USER=admin
# 12 caracteres minimum (ex : openssl rand -base64 24)
BASIC_AUTH_PASSWORD=
# URL publique du collector, utilisee pour generer les snippets d'integration
COLLECTOR_PUBLIC_URL=https://analytics.mondomaine.fr
